# Makefile for MultiCycleALU simulation
# Generated by PyCMT2 SimulationWorkspace

# Verilator configuration
VERILATOR ?= verilator
VERILATOR_FLAGS = --cc --exe --build -j 0 \
    --trace --trace-structs \
    -Wall -Wno-fatal \
    --top-module MultiCycleALU

# Directories
RTL_DIR = rtl
TB_DIR = tb
BUILD_DIR = build
WAVE_DIR = waves

# Source files
RTL_FILES = $(wildcard $(RTL_DIR)/*.sv)
TB_FILE = $(TB_DIR)/testbench.cpp

# Output
SIM_EXE = $(BUILD_DIR)/VMultiCycleALU

# Default target
all: $(SIM_EXE)

# Build simulation executable
$(SIM_EXE): $(RTL_FILES) $(TB_FILE)
	$(VERILATOR) $(VERILATOR_FLAGS) \
		-Mdir $(BUILD_DIR) \
		$(RTL_FILES) \
		$(TB_FILE)

# Run simulation
run: $(SIM_EXE)
	@mkdir -p $(WAVE_DIR)
	./$(SIM_EXE)

# View waveforms (requires GTKWave)
waves: run
	gtkwave $(WAVE_DIR)/MultiCycleALU.vcd &

# Clean build artifacts
clean:
	rm -rf $(BUILD_DIR)/*
	rm -rf $(WAVE_DIR)/*.vcd

# Clean everything
distclean: clean
	rm -rf $(BUILD_DIR)
	rm -rf $(WAVE_DIR)

.PHONY: all run waves clean distclean
